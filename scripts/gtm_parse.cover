    3: def analyse(target, timeout=30):
           """Accept a container ID, a gtm.js URL, or a local file path."""
    3:     if re.fullmatch(r"GTM-[A-Z0-9]{4,10}", target.strip(), re.I):
    1:         url = f"https://www.googletagmanager.com/gtm.js?id={target.strip().upper()}"
    1:         src, status = fetch(url, timeout)
    1:         source = url
    2:     elif target.startswith("http"):
               src, status = fetch(target, timeout)
               source = target
           else:
    4:         with open(target, encoding="utf-8", errors="replace") as fh:
    2:             src = fh.read()
    2:         status, source = 200, target
    3:     data = extract_data_object(src)
    3:     summary = summarise(data, src)
    3:     summary["_source"] = source
    3:     summary["_bytes"] = len(src)
    3:     summary["_http_status"] = status
       
           # Google answers an unknown container ID with HTTP 200 and an *empty*
           # container rather than a 404. Without this check a typo reads as a real
           # company with no tracking, which is a badly wrong finding to report.
    3:     if summary["counts"]["tags"] == 0 and summary["counts"]["variables"] == 0:
    2:         summary["warnings"].insert(0, (
    1:             "EMPTY CONTAINER: 0 tags and 0 variables. Google returns HTTP 200 with an "
                   "empty container for IDs that do not exist or were never published, so treat "
                   "this as 'container not found' unless the ID is confirmed from the page source. "
                   "Do not report it as a company that does no tracking."))
    3:     if "/gtag/js" in source:
               summary["warnings"].insert(0, (
                   "This is a gtag/js file, not a GTM container. It parses because gtag ships a "
                   "similar structure, but it describes one Google tag's own configuration -- not a "
                   "tag manager container. Counts here are not comparable to a GTM-XXXXXXX read."))
    3:     return summary
       
       
    3: def render(s):
    2:     L = []
    2:     a = L.append
    2:     a(f"# GTM container  ({s['_source']})")
    2:     a(f"version {s['container_version']}   {s['_bytes']:,} bytes")
    2:     c = s["counts"]
    2:     a(f"{c['tags']} tags · {c['variables']} variables · {c['trigger_rules']} trigger rules\n")
           # Surface disqualifying warnings before the data, so an empty or wrong-file
           # read can't be mistaken for a real finding.
    5:     for w in s["warnings"]:
    3:         if w.startswith(("EMPTY CONTAINER", "This is a gtag/js")):
    1:             a(f"!! {w}\n")
       
    2:     a("## Tag types")
   29:     for t in s["tag_types"]:
   27:         a(f"  {t['count']:>4}  {t['type']}  [{t['function']}]")
       
    2:     g = s["google_ads_summary"]
    2:     a("\n## Google Ads")
    2:     a(f"  accounts: {', '.join(g['ads_accounts']) or 'none'}")
    2:     a(f"  conversion actions in __awct tags: {g['conversion_actions_in_awct_tags']}  (from {g['conversion_tags']} tags)")
    4:     a(f"  labels tied to an Ads tag/parameter: {g['labels_attached_to_ads_context']}"
    2:       f"   <- the real optimisation surface if they route conversions via GA4/server-side")
    2:     if g["labels"]:
    1:         a(f"  labels: {', '.join(g['labels'][:20])}")
    2:     if g.get("unattributed_label_shaped_strings"):
    2:         a(f"  UNATTRIBUTED label-shaped strings ({len(g['unattributed_label_shaped_strings'])}): "
    1:           f"{', '.join(g['unattributed_label_shaped_strings'][:10])}")
    1:         a(f"    {g['unattributed_note']}")
    2:     a(f"  hardcoded conversion values on tags: {', '.join(g['literal_values_present']) or 'none (runtime dataLayer; check lookup tables below)'}")
       
    2:     if s.get("lookup_tables"):
    1:         a(f"\n## Lookup tables ({len(s['lookup_tables'])}) - hand-typed by their marketers, highest-signal section")
    8:         for t in s["lookup_tables"]:
    7:             a(f"\n  [{t['classification']}]  macro[{t['macro_index']}] {t['type']}, {t['row_count']} rows")
    7:             if t["input"]:
    7:                 a(f"    keyed on: {t['input']}")
   46:             for k, v in t["rows"][:25]:
   39:                 a(f"      {str(k)[:70]:<70} -> {str(v)[:50]}")
    7:             if t["truncated"] or t["row_count"] > 25:
                       a(f"      ... {t['row_count'] - 25} more rows (use --json for all)")
       
    2:     if s.get("gating_groups"):
    1:         a("\n## Conditions gating several tags at once")
    1:         a("   (a condition shared by many destination tags is a policy decision:")
    1:         a("    their working definition of an event worth counting)")
   13:         for grp in s["gating_groups"][:12]:
   12:             a(f"\n  {grp['tag_count']} tags gated on:  {grp['condition']}")
   82:             a(f"     {', '.join(f'{k} x{v}' for k, v in grp['tag_types'].items())}")
       
    2:     if s["ga4_events"]:
