   18:     hints = {"globals": [], "hosts": [], "cookies": [], "permissions": sorted(perm.keys())}
   18:     blob = json.dumps(perm)
   18:     for g in re.findall(r'"key"\s*,\s*"([A-Za-z_$][\w$.]{1,40})"', blob):
               hints["globals"].append(g)
   79:     for h in re.findall(r'(?:https?://)?([a-z0-9.-]+\.[a-z]{2,})/?', blob):
   61:         if "." in h and not h.endswith((".js", ".com.js")):
   53:             hints["hosts"].append(h)
   18:     hints["globals"] = sorted(set(hints["globals"]))[:12]
   18:     hints["hosts"] = sorted(set(hints["hosts"]))[:12]
   18:     return hints
       
       
