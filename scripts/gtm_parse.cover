  731:         right = f"'{a1}'" if len(a1) <= 90 else f"'{a1[:90]}...'"
           else:
               right = json.dumps(a1, default=str)
  731:     return f"{left} {op} {right}"
       
       
    3: def resolve_triggers(res):
           """Map each tag index to the conditions that fire and block it.
       
           Rule clauses are ["if"|"unless"|"add"|"block", <index>, ...]. A rule fires
           its "add" tags when every "if" predicate holds and no "unless" predicate
           does; "block" entries suppress a tag under the same condition set.
           """
    3:     tags = res.get("tags", [])
    3:     rules = res.get("rules", [])
    3:     preds = res.get("predicates", [])
    3:     macros = res.get("macros", [])
  613:     out = {i: {"fires_when": [], "blocked_when": []} for i in range(len(tags))}
       
  358:     for rule in rules:
  355:         if not isinstance(rule, list):
                   continue
  355:         ifs, unlesses, adds, blocks = [], [], [], []
 1100:         for clause in rule:
  745:             if not (isinstance(clause, list) and clause):
                       continue
  745:             kind = clause[0]
  745:             bucket = {"if": ifs, "unless": unlesses, "add": adds, "block": blocks}.get(kind)
  745:             if bucket is None:
                       continue
 3109:             bucket.extend(v for v in clause[1:] if isinstance(v, int))
  355:         cond = {
 1031:             "all_of": [describe_predicate(preds[i], macros) for i in ifs if i < len(preds)],
  410:             "none_of": [describe_predicate(preds[i], macros) for i in unlesses if i < len(preds)],
               }
 1050:         for t in adds:
  695:             if t in out:
  695:                 out[t]["fires_when"].append(cond)
  548:         for t in blocks:
  193:             if t in out:
  193:                 out[t]["blocked_when"].append(cond)
    3:     return out
       
       
    3: def condition_text(cond):
