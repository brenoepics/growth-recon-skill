    1: def collect(target, pricing_override=None, signup_override=None, do_locales=True):
    1:     url = norm_url(target)
    1:     home = fetch_full(url)
    1:     parsed = urllib.parse.urlparse(home["url"] or url)
    1:     origin = f"{parsed.scheme}://{parsed.netloc}"
    1:     own_host = parsed.netloc.lower()
       
    1:     rep = {"target": url, "origin": origin, "home_status": home["status"], "notes": []}
       
    1:     if pricing_override:
               pu = urllib.parse.urljoin(origin, pricing_override)
