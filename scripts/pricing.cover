    3:         ma, mm_ = PRICE_PREFIX_RE.search(str(av)), PRICE_PREFIX_RE.search(str(mv))
    3:         if not ma or not mm_ or ma.group(1) != mm_.group(1):
                   continue
    3:         a_, m_ = _to_float(ma.group(2)), _to_float(mm_.group(2))
    3:         if not a_ or not m_ or m_ <= 0 or a_ > m_:
