    1: def fetch_full(url, timeout=TIMEOUT):
           """Fetch body + headers + final URL, falling back to curl.
       
           Same shape as recon.py's fetcher, and the curl fallback exists for the same
           reason: a stock macOS Python frequently has no usable CA store, and silently
           reporting "page not found" because of a local certificate problem would look
           identical to a site that has no pricing page.
           """
   14:     req = urllib.request.Request(url, headers={
    7:         "User-Agent": UA, "Accept": "text/html,application/xhtml+xml,*/*;q=0.8",
    7:         "Accept-Encoding": "gzip, deflate", "Accept-Language": "en-US,en;q=0.9",
           })
    7:     try:
    7:         ctx = ssl.create_default_context()
    7:         with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
                   raw = r.read()
                   enc = (r.headers.get("Content-Encoding") or "").lower()
                   if "gzip" in enc:
                       raw = gzip.decompress(raw)
                   elif "deflate" in enc:
                       try:
                           raw = zlib.decompress(raw)
                       except zlib.error:
                           raw = zlib.decompress(raw, -zlib.MAX_WBITS)
                   return {"url": r.url, "status": r.status, "body": raw.decode("utf-8", "replace"),
                           "headers": dict(r.headers.items())}
    7:     except urllib.error.HTTPError as e:
               return {"url": url, "status": e.code, "body": "",
                       "headers": dict(e.headers.items()) if e.headers else {}}
    7:     except Exception:
    7:         return _curl_full(url, timeout)
       
       
    1: def _curl_full(url, timeout):
    7:     try:
   14:         p = subprocess.run(
   14:             ["curl", "-sSL", "--compressed", "-D", "-", "--max-time", str(timeout),
    7:              "-A", UA, "-H", "Accept-Language: en-US,en;q=0.9",
    7:              "-w", "\n__FINAL__%{url_effective}\n__STATUS__%{http_code}", url],
    7:             capture_output=True, text=True, timeout=timeout + 15)
    7:         out = p.stdout
    7:         final = re.search(r"\n__FINAL__(.*)", out)
    7:         status = re.search(r"\n__STATUS__(\d+)", out)
    7:         out = re.sub(r"\n__FINAL__.*", "", out, flags=re.S)
    7:         parts = re.split(r"\r?\n\r?\n", out)
    7:         headers, body = {}, out
   26:         for i, blk in enumerate(parts):
   19:             if blk.startswith("HTTP/"):
    9:                 headers = {}
  153:                 for line in blk.splitlines()[1:]:
  144:                     if ":" in line:
  144:                         k, _, v = line.partition(":")
  144:                         headers[k.strip()] = v.strip()
    9:                 body = "\n\n".join(parts[i + 1:])
   14:         return {"url": final.group(1).strip() if final else url,
    7:                 "status": int(status.group(1)) if status else 0,
    7:                 "body": body, "headers": headers}
           except Exception as e:
               return {"url": url, "status": 0, "body": "", "headers": {}, "error": str(e)[:200]}
       
       
    1: def strip_tags(frag):
 1423:     frag = re.sub(r"(?is)<(script|style|svg|noscript)[^>]*>.*?</\1>", " ", frag)
 1423:     frag = re.sub(r"(?s)<[^>]+>", " ", frag)
 1423:     return re.sub(r"\s+", " ", htmllib.unescape(frag)).strip()
       
       
