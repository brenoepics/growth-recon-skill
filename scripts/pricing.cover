           else:
    1:         disc, pr = pick_pricing(origin, home["body"], own_host)
       
    1:     rep["pricing_discovery"] = disc
       
    1:     if not pr or pr["status"] != 200:
               rep["pricing"] = {"found": False,
                                 "note": ("No pricing page could be fetched. Paths tried are listed under "
                                          "pricing_discovery.tried. Absence of a URL is not evidence of "
                                          "absence of pricing — some companies publish prices only inside "
                                          "the product or in a PDF.")}
               rep["notes"].append("pricing page not reachable; nothing below describes their tiers")
           else:
    1:         doc = pr["body"]
               # Embedded JSON is mined from the raw document; everything structural is
               # read from the markup with inline CSS and scripts removed.
    1:         emb = mine_embedded_json(doc)
    1:         doc_m = markup_only(doc)
    1:         prices = find_prices(doc_m)
    1:         cards = segment_cards(doc_m)
    1:         shape = pricing_shape(doc_m)
    1:         gates = feature_matrix(doc_m)
   18:         rep["pricing"] = {
    1:             "found": True,
    1:             "url": pr["url"],
    1:             "html_bytes": len(doc),
    1:             "rendering": rendering_verdict(doc_m, prices, len(emb["price_fields"]) + len(emb["offers"])),
    1:             "tiers": cards,
    5:             "tier_names": [c["tier_label"] for c in cards],
    1:             "tiers_from_structured_data": tiers_from_structured_data(emb),
    1:             "markup_readable": bool(prices or cards),
    1:             "prices_in_markup": prices[:40],
    1:             "embedded_json": emb,
    1:             "shape": shape,
    1:             "monthly_vs_annual": monthly_annual_delta(cards, shape, emb, gates),
    1:             "promoted_tier": promoted_tier(cards, doc_m),
    1:             "self_serve_boundary": self_serve_boundary(cards, doc),
    1:             "feature_gates": gates,
    1:             "sku_identifiers": sku_identifiers(doc),
    1:             "currency": currency_switcher(doc_m),
               }
    1:         if rep["pricing"]["feature_gates"] is None and rep["pricing"]["markup_readable"]:
                   rep["notes"].append(
                       "No machine-readable plan-comparison table. Feature gates on this page are drawn "
                       "with icons or divs, so per-tier differences could not be extracted; the per-tier "
