               # page (a footer plan card would otherwise move the line).
   10:         first_sales_idx = next(i for i, c in enumerate(cards)
    5:                                if c["contact_sales"] and not c["prices"])
    4:         before = [c["tier_label"] for c in cards[:first_sales_idx] if c["prices"]]
    2:         verdict = (f"self-serve through {(before or priced)[-1]!r}; "
    1:                    f"{cards[first_sales_idx]['tier_label']!r} and above are sales-assisted "
                          f"(no price published)")
