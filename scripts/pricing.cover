    1:         if do_locales:
                   rep["locales"] = locale_variants(pr["url"], doc, price_literals(doc), price_amounts(doc))
       
    1:     sig_disc, sr = pick_signup(origin, pr["body"] if pr else "", home["body"], own_host, signup_override)
    1:     rep["signup_discovery"] = sig_disc
    1:     if sr and sr["status"] == 200:
    2:         rep["signup"] = {"found": True, "url": sr["url"], "html_bytes": len(sr["body"]),
    1:                          **signup_structure(sr["body"], sr["url"])}
    1:         if rep["signup"]["field_count"] == 0 and not rep["signup"]["sso_providers"]:
