  138:         got = {v.upper() for v, _ in opts if re.fullmatch(r"[A-Za-z]{3}", v)}
    4:         if len(got & {"USD", "EUR", "GBP", "AUD", "CAD", "JPY", "INR", "BRL", "SGD", "CHF",
    2:                       "SEK", "MXN", "ZAR", "NZD", "PLN", "DKK", "NOK", "AED", "ILS", "HKD"}) >= 2:
