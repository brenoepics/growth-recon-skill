    1: def main():
           # An explicit --help is a request that succeeded, so it exits 0. Running with
           # no arguments at all is a usage error and still exits 1.
    1:     if "--help" in sys.argv or "-h" in sys.argv:
               print(__doc__)
               return 0
    1:     argv = sys.argv[1:]
    1:     if not argv or argv[0].startswith("--"):
               print(__doc__)
               return 1
    1:     target = argv[0]
    1:     pricing = signup = None
    1:     out_json = None
    1:     want_json = "--json" in argv
    1:     if "--pricing" in argv:
               i = argv.index("--pricing")
               pricing = argv[i + 1] if len(argv) > i + 1 else None
    1:     if "--signup" in argv:
               i = argv.index("--signup")
               signup = argv[i + 1] if len(argv) > i + 1 else None
    1:     if want_json:
               i = argv.index("--json")
               if len(argv) > i + 1 and not argv[i + 1].startswith("--"):
                   out_json = argv[i + 1]
       
    1:     rep = collect(target, pricing, signup, do_locales="--no-locales" not in argv)
       
    1:     if want_json and not out_json:
               print(json.dumps(rep, indent=2, default=str))
               return 0
    1:     print(render(rep))
    1:     if out_json:
               with open(out_json, "w", encoding="utf-8") as fh:
                   json.dump(rep, fh, indent=2, default=str)
               print(f"\n[raw facts written to {out_json}]")
    1:     return 0
       
       
    1: if __name__ == "__main__":
    1:     sys.exit(main())
