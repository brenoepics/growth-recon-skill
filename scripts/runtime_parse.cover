    2:         if not any(k in node for k in ("log", "requests", "entries", "network",
                                              "networkRequests", "hits", "resources", "har",
                                              "dataLayer", "datalayer", "data_layer",
                                              "pushes", "dl")):
                   if _looks_like_request(node):
                       requests.append(node)
                   else:
                       pushes.append(node)
       
       
    3: def load_capture(path):
           """Read one capture file. Returns (requests, dataLayer pushes, notes)."""
    3:     notes = []
    3:     try:
    6:         with open(path, encoding="utf-8", errors="replace") as fh:
    3:             raw = fh.read()
           except OSError as e:
               return [], [], [f"!! could not read {path}: {e}"]
    3:     if not raw.strip():
               return [], [], [f"!! {path} is empty"]
       
    3:     requests, pushes = [], []
    3:     try:
    3:         data = json.loads(raw)
           except ValueError:
               # Not JSON. A pasted list of URLs is a perfectly reasonable capture, and
               # so is JSON-lines, so pull URLs out line by line instead of refusing.
               for line in raw.splitlines():
                   line = line.strip().strip(",").strip('"')
                   if line.startswith("{"):
                       try:
                           obj = json.loads(line)
                       except ValueError:
                           continue
                       (requests if _looks_like_request(obj) else pushes).append(obj)
                       continue
                   m = re.search(r"https?://\S+", line)
                   if m:
                       requests.append({"url": m.group(0).rstrip('",;)')})
               notes.append(f"{path} is not JSON -- read {len(requests)} URL(s) line by line")
               return requests, pushes, notes
       
    3:     _collect(data, requests, pushes)
    3:     return requests, pushes, notes
       
       
       # ---------------------------------------------------------------------------
       # Query-string handling. Two wrinkles the obvious implementation gets wrong:
       # Floodlight separates its params with ';' instead of '&', and GA4 sends repeated
       # pr<N> params that must not collapse into one.
       # ---------------------------------------------------------------------------
    3: def parse_params(url):
   29:     try:
   29:         parsed = urllib.parse.urlsplit(url)
           except ValueError:
               return {}, "", ""
   29:     host, path, query = parsed.netloc.lower(), parsed.path, parsed.query
       
           # Floodlight puts its payload in the PATH as ;key=value pairs (and some
           # Google Ads endpoints do too), so the standard parser sees no query at all.
   29:     semi = ""
   29:     if ";" in path:
    3:         path, _, semi = path.partition(";")
   29:     blob = query if query else ""
   29:     if semi:
    3:         blob = (blob + "&" if blob else "") + semi.replace(";", "&")
       
   29:     out = OrderedDict()
  436:     for part in re.split(r"[&]", blob):
  407:         if not part:
    4:             continue
  403:         k, _, v = part.partition("=")
  403:         k = urllib.parse.unquote_plus(k)
  403:         v = urllib.parse.unquote_plus(v)
  403:         if k in out and out[k] != v:
                   out[k] = out[k] + " | " + v
               else:
  403:             out[k] = v
   29:     return out, host, path
       
       
    3: def as_number(raw):
           """Parse a value param. Returns (float|None, state).
       
           The state is the point of the whole exercise: a hit that carries `value=` with
           nothing in it is a different and more interesting finding than a hit with no
           value param at all, because it means the plumbing is there and the number is
           not arriving.
           """
   11:     if raw is None:
               return None, "absent"
   11:     s = str(raw).strip()
   11:     if not s:
               return None, "present-but-empty"
   11:     s = s.replace(",", "") if re.fullmatch(r"-?\d{1,3}(,\d{3})*(\.\d+)?", s) else s
   11:     try:
   11:         return float(s), "number"
           except ValueError:
               return None, "present-but-not-numeric"
       
       
    3: def pick_value(params, keys):
   69:     for k in keys:
   55:         if k in params:
    7:             num, state = as_number(params[k])
    7:             return {"value": num, "state": state, "source": k, "raw": params[k][:60]}
   14:     return {"value": None, "state": "absent", "source": None, "raw": None}
       
       
    3: def pick_currency(params, keys):
   85:     for k in keys:
   66:         v = (params.get(k) or "").strip()
   66:         if v:
    2:             return v.upper()[:8]
   19:     return None
       
       
    3: def decode_gcs(gcs):
           """Decode Google's consent signal string, e.g. G111.
       
           Format is 'G' + format version + ad_storage + analytics_storage, each 1 or 0.
           Reported only when it is that exact shape; Google has changed this before and
           a mis-decoded consent state is worse than a raw one.
           """
   24:     if not isinstance(gcs, str) or not re.fullmatch(r"G\d{3}", gcs):
    9:         return None
   15:     m = {"1": "granted", "0": "denied"}
   30:     return {"ad_storage": m.get(gcs[2], gcs[2]),
   15:             "analytics_storage": m.get(gcs[3], gcs[3])}
       
       
    3: def decode_ga4_items(params):
