    6:     if v["source"] == "ep.value":
    2:         hit["notes"].append("value arrived in ep.* (string namespace), not epn.* (numeric)")
    6:     if "sdl" in params:
               blob = try_base64_json(params["sdl"])
               if blob is not None:
                   hit["notes"].append("sdl= carries a base64 JSON product list")
                   hit["decoded_extras"] = {"sdl": blob}
    6:     return hit
       
       
    3: def decode_google_ads_conversion(url, host, path, params):
