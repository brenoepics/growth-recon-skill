    8:                 name = GA4_ITEM_PREFIXES.get(prefix)
    8:                 if name and val != "":
    6:                     item[name] = val
    3:         for slot in custom.values():
    2:             if slot.get("key"):
    2:                 item[slot["key"]] = slot.get("value", "")
    1:         if item:
    1:             items.append(item)
    6:     return items
       
       
    3: def decode_semicolon_blob(raw):
           """Google Ads remarketing packs its custom params into one `data=` string as
           `key=value;key=value`. It routinely carries the page type, product id and the
           business vertical -- their own segmentation, in their own words."""
    2:     out = OrderedDict()
   14:     for part in str(raw).split(";"):
   12:         k, _, v = part.partition("=")
   12:         if k.strip():
   12:             out[k.strip()] = v.strip()
    2:     return out
       
       
    3: def try_base64_json(raw):
           """Some Google endpoints carry a base64 JSON blob (`sdl`) listing the page's
           products with prices. Attempted only where it is cheap, and silently skipped
           when it is not that -- most base64-looking params are opaque ids."""
           s = str(raw)
           if len(s) < 24 or not re.fullmatch(r"[A-Za-z0-9+/_=-]+", s):
               return None
           try:
               pad = "=" * (-len(s) % 4)
               text = base64.urlsafe_b64decode(s + pad).decode("utf-8", errors="strict")
           except Exception:
               return None
           try:
               return json.loads(text)
           except ValueError:
               return None
       
       
    3: def user_data_present(params):
  819:     return [f"{k} ({USER_DATA_KEYS[k]})" for k in params
  408:             if k in USER_DATA_KEYS and str(params[k]).strip()]
       
       
       # ---------------------------------------------------------------------------
       # Per-vendor decoders. Each returns a hit dict or None.
       #
       # Routing is by `tid` prefix before host, deliberately: /ccm/collect is served
       # from google.com, pagead2.googlesyndication.com and others, and carries GA4
       # hits (tid=G-) and Google Ads hits (tid=AW-) through the same path. Routing on
       # the host alone mislabels every Ads conversion on a modern gtag site.
       # ---------------------------------------------------------------------------
    3: def _base_hit(vendor, endpoint, url, params):
   21:     gcs = params.get("gcs")
   21:     return {
   21:         "vendor": vendor,
   21:         "endpoint": endpoint,
   21:         "event": None,
   21:         "account": None,
   21:         "value": None,
   21:         "value_state": "absent",
   21:         "value_source": None,
   21:         "currency": None,
   21:         "items": [],
   21:         "event_params": {},
   21:         "user_data": user_data_present(params),
   42:         "consent": {"gcs": gcs, "gcs_decoded": decode_gcs(gcs),
   21:                     "gcd_raw": params.get("gcd"),
   21:                     "npa": params.get("npa")},
   21:         "page": params.get("dl") or params.get("url") or params.get("p") or params.get("~oref"),
   21:         "notes": [],
   21:         "url": url[:400],
           }
       
       
    3: def decode_google_collect(url, host, path, params):
           """GA4 and gtag-routed Google Ads hits: /g/collect, /collect, /ccm/collect."""
    6:     tid = params.get("tid") or params.get("tids") or ""
    6:     is_ads = tid.startswith(("AW-", "DC-"))
    6:     vendor = "Google Ads (gtag)" if is_ads else "GA4"
    6:     hit = _base_hit(vendor, host + path, url, params)
    6:     hit["account"] = tid or None
    6:     hit["event"] = params.get("en") or None
    6:     v = pick_value(params, ADS_VALUE_KEYS if is_ads else GA4_VALUE_KEYS)
    6:     hit.update({"value": v["value"], "value_state": v["state"], "value_source": v["source"]})
    6:     hit["currency"] = pick_currency(params, ADS_CURRENCY_KEYS if is_ads else GA4_CURRENCY_KEYS)
    6:     hit["items"] = decode_ga4_items(params)
