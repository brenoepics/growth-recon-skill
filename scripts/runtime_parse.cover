    6:     items = []
  157:     for key in sorted((k for k in params if re.fullmatch(r"pr\d+", k)),
    7:                       key=lambda k: int(k[2:])):
    1:         item = {}
    1:         custom = {}
   13:         for field in params[key].split("~"):
   12:             if len(field) < 2:
                       continue
   12:             prefix, val = field[:2], field[2:]
   12:             if re.fullmatch(r"k\d", prefix):
    2:                 custom.setdefault(prefix[1], {})["key"] = val
   10:             elif re.fullmatch(r"v\d", prefix):
    2:                 custom.setdefault(prefix[1], {})["value"] = val
