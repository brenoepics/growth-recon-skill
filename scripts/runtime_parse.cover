    3: def main():
           # An explicit --help is a request that succeeded, so it exits 0. Running with
           # no arguments at all is a usage error and still exits 1.
    3:     if "--help" in sys.argv or "-h" in sys.argv:
               print(__doc__)
               return 0
    3:     argv = sys.argv[1:]
    3:     if not argv or "--help" in argv or "-h" in argv:
               print(__doc__)
               return 1
    3:     files, dl_files = [], []
    3:     i = 0
    7:     while i < len(argv):
    4:         arg = argv[i]
    4:         if arg in ("--datalayer", "--dl"):
                   if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                       dl_files.append(argv[i + 1])
                       i += 1
                   else:
                       print(f"{arg} needs a file path", file=sys.stderr)
                       return 2
    4:         elif not arg.startswith("--"):
    3:             files.append(arg)
    4:         i += 1
       
    3:     requests, pushes, notes = [], [], []
    6:     for path in files:
    3:         r, p, n = load_capture(path)
    3:         requests += r
    3:         pushes += p
    3:         notes += n
    3:         notes.append(f"{path}: {len(r)} request(s), {len(p)} dataLayer push(es)")
    3:     for path in dl_files:
               r, p, n = load_capture(path)
               # An explicit --datalayer file is a dataLayer file even if the sniffing
               # heuristic disagreed about some of its entries.
               pushes += p + [x for x in r if isinstance(x, dict)]
               notes += n
               notes.append(f"{path} (as dataLayer): {len(p) + len(r)} push(es)")
       
    3:     try:
    3:         s = analyse(requests, pushes, notes)
           except Exception as e:
               print(f"could not analyse capture: {e}", file=sys.stderr)
               return 2
    3:     print(json.dumps(s, indent=2, default=str) if "--json" in argv else render(s))
    3:     return 0
       
       
    3: if __name__ == "__main__":
    3:     sys.exit(main())
