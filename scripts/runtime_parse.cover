  290:     if any(k in obj for k in ("method", "status", "initiatorType", "resourceType",
                                     "response", "statusCode", "mimeType")):
   29:         return True
   12:     if "request" in obj and isinstance(obj["request"], dict):
               return True
   72:     if any(k in obj for k in ("event", "ecommerce", "gtm.start", "gtm.uniqueEventId")):
    6:         return False
    6:     return _url_of(obj) is not None
       
       
    3: def _collect(node, requests, pushes, depth=0):
           """Walk an arbitrary decoded JSON structure, sorting what it finds."""
    4:     if depth > 6:
               return
    4:     if isinstance(node, str):
