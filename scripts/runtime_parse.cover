                   requests.append({"url": node})
               return
    4:     if isinstance(node, list):
   44:         for item in node:
   41:             if isinstance(item, (str, list)):
                       _collect(item, requests, pushes, depth + 1)
   41:             elif isinstance(item, dict):
   41:                 if _looks_like_request(item):
   29:                     requests.append(item)
                       else:
   12:                     pushes.append(item)
    3:         return
    1:     if isinstance(node, dict):
               # A HAR file, or a hand-rolled wrapper object.
    1:         if isinstance(node.get("log"), dict):
    1:             _collect(node["log"].get("entries") or [], requests, pushes, depth + 1)
    8:         for key in ("requests", "entries", "network", "networkRequests", "hits",
                           "resources", "har"):
    7:             if key in node:
