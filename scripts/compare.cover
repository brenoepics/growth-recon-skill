    1:     if flat:
    2:         a("\n  Identical across the set, so they differentiate nothing here: "
    3:           + ", ".join(s["label"] for s in flat))
       
    1:     a(f"\n## Where each one sits against the set")
    3:     for p in ok:
    2:         rows = outliers.get(p["label"], [])
    2:         if rows:
    4:             bits = [f"{side} {s['short']} ({fmt(s['values'][p['label']], s['kind'])})"
    6:                     for side, _, s in rows[:4]]
    2:             a(f"  {p['label']:<26} {'; '.join(bits)}")
