           else:
    1:         a("  fewer than two targets have a parsed container with named GA4 events, so")
    1:         a("  there is no vocabulary to compare.")
       
    1:     a("\n## Per-target inventory")
    3:     for p in profiles:
    2:         if not p.get("ok"):
                   a(f"\n  {p['label']}  -- GAP: {p.get('gap')}")
