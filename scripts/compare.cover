    2:         m = p["metrics"]
    2:         a(f"\n  {p['label']}  ({p['depth']}, HTTP {p.get('http_status')})")
    6:         cont = ", ".join(f"{g} ({t:,} tags)" if isinstance(t, int) else f"{g} (not parsed)"
    4:                          for g, t in (p.get("per_container_tags") or {}).items())
    2:         a(f"    containers: {cont or 'none found'}")
    2:         if p.get("tags_without_a_container"):
