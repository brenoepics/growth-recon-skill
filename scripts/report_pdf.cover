               return src
    1:     path = src if os.path.isabs(src) else os.path.join(base_dir, src)
    1:     try:
    1:         with open(path, "rb") as fh:
                   raw = fh.read()
    1:     except OSError:
    1:         return None
           mime = mimetypes.guess_type(path)[0] or "image/png"
           return f"data:{mime};base64," + base64.b64encode(raw).decode("ascii")
       
       
