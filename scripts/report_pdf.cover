  100:         words = len(sent.split())
  100:         if words > 34:
    5:             long_sents.append((words, " ".join(sent.split()[:9])))
    3:     if long_sents:
    2:         notes.append(f"{len(long_sents)} sentence{'s' if len(long_sents) != 1 else ''} "
    7:                      f"over 34 words. Longest {max(w for w, _ in long_sents)}: "
    1:                      f'"{max(long_sents)[1]}..."')
       
    3:     found = {}
    3:     low = prose.lower()
