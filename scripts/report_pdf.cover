   15:         if flag in sys.argv:
                   i = sys.argv.index(flag)
                   if len(sys.argv) > i + 1 and not sys.argv[i + 1].startswith("-"):
                       return sys.argv[i + 1]
   15:         return None
       
    3:     out = opt("-o") or opt("--out") or os.path.splitext(src)[0] + ".pdf"
    6:     with open(src, encoding="utf-8", errors="replace") as fh:
    3:         md = fh.read()
       
    3:     base_dir = os.path.dirname(os.path.abspath(src))
    6:     page = build_html(md, base_dir, title=opt("--title"), subtitle=opt("--subtitle"),
    3:                       eyebrow=opt("--eyebrow") or "Growth recon")
       
    3:     html_path = os.path.splitext(out)[0] + ".html"
    6:     with open(html_path, "w", encoding="utf-8") as fh:
    3:         fh.write(page)
       
    3:     imgs = page.count("<figure>")
    3:     print(f"html  {html_path}  ({len(page):,} bytes, {imgs} image{'s' if imgs != 1 else ''} embedded)")
       
    3:     notes = style_check(md)
    3:     if notes and "--no-style-check" not in sys.argv:
    1:         print("\nplain language: this report asks more of a reader than it needs to")
    3:         for note in notes:
    2:             print(f"  - {note}")
       
    3:     if "--html-only" in sys.argv:
