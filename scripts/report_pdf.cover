    3:     prose = re.sub(r"`[^`]*`", "", prose)                  # and inline code
    3:     prose = re.sub(r"\|.*\|", "", prose)                   # and table rows
    3:     prose = re.sub(r"^\s*#.*$", "", prose, flags=re.M)      # and headings
       
    3:     notes = []
       
