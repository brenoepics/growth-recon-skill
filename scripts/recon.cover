               widened.update(fingerprint(" ".join(report["csp"]["allowed_domains"]), source="csp"))
    2:     container_hosts = []
    2:     for gid, c in report["gtm_containers"].items():
               if isinstance(c, dict) and not c.get("error"):
                   container_hosts += [h["host"] for h in c.get("custom_html_hosts", [])]
                   for t in c.get("custom_templates", []):
                       container_hosts += t.get("fingerprint", {}).get("hosts", [])
                       container_hosts += t.get("fingerprint", {}).get("globals", [])
    2:     if container_hosts:
               for k, v in fingerprint(" ".join(container_hosts), source="gtm-container").items():
                   widened.setdefault(k, v)
    2:     for k, v in widened.items():
               if k not in report["fingerprints"]:
                   report["fingerprints"][k] = v
    2:     report["stack_sources_note"] = (
    2:         "A vendor seen only in 'csp' or 'gtm-container' is still live -- it is "
               "loaded at runtime rather than written into the served HTML.")
       
           # --- who they are as an advertiser, and where to watch their ads ------
    2:     report["advertiser"] = advertiser_identity(html, host, report["gtm_containers"])
    2:     report["ad_libraries"] = ad_library_links(report["advertiser"])
       
           # --- VWO settings file (live test names) ------------------------------
           # Runs last, because VWO is usually detected from the container rather than
           # the HTML, so the fingerprint set has to be widened first.
    2:     if "VWO" in report["fingerprints"]:
               acct = None
               for c in report["gtm_containers"].values():
                   if isinstance(c, dict):
                       got = (c.get("vendor_account_ids") or {}).get("vwo")
                       if got:
                           acct = got[0]
                           break
               acct = acct or discover_vwo_account(html, json.dumps(report["gtm_containers"], default=str))
               if acct:
                   report["experimentation"][f"vwo:{acct}"] = fetch_vwo(acct, report["final_url"] or url)
               else:
                   report["collection_notes"].append(
                       "VWO detected but no account ID found; grep the raw gtm.js for _vwo_code "
                       "or visualwebsiteoptimizer.com/j.php?a=")
       
    2:     return report
       
       
    2: def render(r):
    2:     L = []
    2:     a = L.append
    2:     a(f"# Public recon: {r['final_url']}   (HTTP {r['http_status']}, {r['html_bytes']:,} bytes HTML)")
    2:     ident = r.get("identity") or {}
    2:     if ident.get("warning"):
               a("")
               a("!! " + ident["warning"])
               a("")
    2:     if r["meta"]["title"]:
    2:         a(f"title: {r['meta']['title']}")
    2:     if r["meta"]["generator"]:
               a(f"generator: {r['meta']['generator']}")
    2:     if r["meta"]["hreflang_locales"]:
    1:         a(f"locales (hreflang): {', '.join(r['meta']['hreflang_locales'])}")
       
    2:     a("\n## Response headers")
   10:     for k, v in r["response_headers"].items():
    8:         a(f"  {k}: {str(v)[:220]}")
    2:     if r["cookies_set_on_first_load"]:
               a(f"  cookies set pre-consent: {', '.join(r['cookies_set_on_first_load'])}")
       
    2:     if r["csp"]:
               doms = r["csp"]["allowed_domains"]
               a(f"\n## CSP allowlist ({len(doms)} domains) - their own inventory of third parties")
               if len(doms) < 3:
                   a("  PERMISSIVE OR EMPTY CSP (e.g. default-src *): this says nothing about their stack.")
                   a("  Read it as 'no information', not as a small vendor footprint.")
               a("  " + ", ".join(doms[:80]))
           else:
    2:         a("\n## CSP: none served")
    2:         a("  No CSP means the stack-enumeration shortcut is unavailable here, not that the")
    2:         a("  stack is thin. Fall back to container hosts and the --pages sweep.")
       
    3:     strong = {k: v for k, v in r["fingerprints"].items() if v.get("evidence") != "weak"}
    3:     weak = {k: v for k, v in r["fingerprints"].items() if v.get("evidence") == "weak"}
    2:     a(f"\n## Vendor fingerprints ({len(strong)} with load evidence)")
    3:     for k, v in strong.items():
    1:         ids = f"  ids={v['ids']}" if v["ids"] else ""
    1:         src = v.get("source", "html")
    1:         tag = "" if src == "html" else f"  [seen in {src}]"
    1:         a(f"  {k:<28} x{v['occurrences']:<3} {v['implies']}{ids}{tag}")
    2:     if r.get("stack_sources_note"):
    2:         a(f"  note: {r['stack_sources_note']}")
    2:     if weak:
               a(f"\n## Name mentioned, no load evidence ({len(weak)}) -- verify before reporting")
               a("   (a bare product name also matches an integrations directory or a competitor list)")
               for k, v in weak.items():
                   a(f"  {k:<28} x{v['occurrences']:<3} matched text only")
       
    2:     if r["third_party_hosts"]:
    1:         a("\n## Third-party hosts referenced in HTML")
   26:         for h in r["third_party_hosts"][:35]:
   25:             a(f"  {h['refs']:>3}  {h['host']}")
       
   12:     for path, e in r["well_known"].items():
   10:         a(f"\n## {path}  ({e['bytes']:,} bytes)")
   10:         if e.get("ai_crawler_verdicts"):
                   a("  AI crawlers:")
                   for agent, verdict in sorted(e["ai_crawler_verdicts"].items()):
                       a(f"    {agent:<28} {verdict}")
   10:         elif path == "/robots.txt":
    1:             a("  AI crawlers: none named in robots.txt")
   10:         if e.get("content_signal"):
                   a(f"  Content-Signal: {e['content_signal']}")
   50:         for key in ("disallow", "sitemaps", "sellers", "user_agents"):
   40:             if e.get(key):
    3:                 a(f"  {key}: {', '.join(map(str, e[key][:40]))}")
   10:         if e.get("excerpt"):
    8:             a("  " + e["excerpt"][:400].replace("\n", "\n  "))
       
    2:     if r["sitemap"]:
    1:         s = r["sitemap"]
    1:         a(f"\n## Sitemap ({s['total_urls']:,} URLs from {s['source']})")
   27:         a("  top path prefixes: " + ", ".join(f"{k} ({v})" for k, v in list(s["path_prefixes"].items())[:25]))
       
    2:     if r["gtag"]:
               a("\n## gtag/js")
               for gid, v in r["gtag"].items():
                   a(f"  {gid}: linked -> {', '.join(v.get('linked_ids', [])) or v.get('error', 'none')}")
       
    2:     adv = r.get("advertiser") or {}
    2:     if r.get("ad_libraries"):
    2:         a("\n## Live ads - open these to see what they are running right now")
    2:         if adv.get("google_ads_accounts"):
                   a(f"  google ads accounts in their container: {', '.join(adv['google_ads_accounts'])}")
    2:         if adv.get("facebook_page_ids"):
    1:             a(f"  facebook page id: {', '.join(adv['facebook_page_ids'])}")
    1:         elif adv.get("facebook_slugs"):
                   a(f"  facebook page slug: {', '.join(adv['facebook_slugs'][:3])}  (no numeric id published)")
    2:         if adv.get("meta_pixel_ids"):
                   a(f"  meta pixel ids: {', '.join(adv['meta_pixel_ids'][:4])}")
    2:         a("")
   12:         for name, v in r["ad_libraries"].items():
   10:             flag = {"open": "OPEN     ", "manual": "1 STEP   ", "sign-in": "SIGN-IN  "}.get(v["status"], "         ")
   10:             a(f"  {flag}{name}")
   10:             a(f"      {v['url']}")
   10:             a(f"      {v['shows']}")
   10:             if v.get("next_step"):
    1:                 a(f"      next: {v['next_step']}")
       
    2:     if r["experimentation"]:
               a("\n## Experimentation datafiles (public)")
               for u, v in r["experimentation"].items():
                   a(f"  {u}")
                   for key in ("experiments", "feature_flags", "events", "audiences",
                               "readable_names", "campaign_names", "campaign_types"):
                       if v.get(key):
                           a(f"    {key} ({len(v[key])}): {', '.join(map(str, v[key][:30]))}")
                   if v.get("note"):
                       a(f"    note: {v['note']}  ({v.get('format','')}, {v.get('bytes',0):,} bytes)")
       
    2:     if r["dns"]:
    2:         a("\n## DNS")
    9:         for k, v in r["dns"].items():
    7:             a(f"  {k}: {', '.join(map(str, v[:8]))[:400]}")
       
    2:     if r["extra_pages"]:
               a("\n## Extra pages")
               for p, v in r["extra_pages"].items():
                   a(f"  {p}  HTTP {v['status']}")
                   if v.get("new_fingerprints"):
                       a(f"    page-only vendors: {', '.join(v['new_fingerprints'])}")
                   if v.get("name_only_no_load_evidence"):
                       a(f"    name-only on this page (verify): {', '.join(v['name_only_no_load_evidence'])}")
                   if v.get("forms"):
                       a(f"    form actions: {', '.join(v['forms'][:8])}")
       
    2:     cd_ = r.get("container_discovery") or {}
    2:     a(f"\n## GTM containers found: {', '.join(r['gtm_containers'].keys()) or 'none'}")
    2:     if cd_:
    4:         a(f"   from pages: {', '.join(cd_.get('from_pages', [])) or 'none'}"
    2:           f"   from zones: {', '.join(cd_.get('from_zones', [])) or 'none'}")
    2:         if cd_.get("sibling_hosts"):
                   a(f"   other hosts on this domain (may have their own containers): "
                     f"{', '.join(cd_['sibling_hosts'])}")
    2:     a("   (run scripts/gtm_parse.py <ID> for the full container read, or see --json)")
    2:     if r["collection_notes"]:
               a("\n## Collection notes")
               for n in r["collection_notes"]:
                   a(f"  - {n}")
    2:     return "\n".join(L)
       
       
    2: def main():
           # An explicit --help is a request that succeeded, so it exits 0. Running with
           # no arguments at all is a usage error and still exits 1.
    2:     if "--help" in sys.argv or "-h" in sys.argv:
               print(__doc__)
               return 0
    2:     argv = sys.argv[1:]
    2:     if not argv:
               print(__doc__)
               return 1
    2:     target = argv[0]
    2:     pages = []
    2:     out_json = None
    2:     if "--pages" in argv:
               pages = [p.strip() for p in argv[argv.index("--pages") + 1].split(",") if p.strip()]
    2:     if "--json" in argv:
               i = argv.index("--json")
               out_json = argv[i + 1] if len(argv) > i + 1 and not argv[i + 1].startswith("--") else "recon.json"
    2:     rep = collect(target, pages, do_containers="--no-containers" not in argv)
    2:     print(render(rep))
    2:     if out_json:
               with open(out_json, "w", encoding="utf-8") as fh:
                   json.dump(rep, fh, indent=2, default=str)
               print(f"\n[raw facts written to {out_json}]")
    2:     return 0
       
       
    2: if __name__ == "__main__":
    2:     sys.exit(main())
