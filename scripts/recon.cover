    2:     seen = {}
    6:     for name, pat in (("canonical", r'<link[^>]+rel=["\']canonical["\'][^>]+href=["\']([^"\']+)'),
                             ("og:url", r'<meta[^>]+property=["\']og:url["\'][^>]+content=["\']([^"\']+)')):
