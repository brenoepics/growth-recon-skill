    2: def fetch_full(url, timeout=TIMEOUT):
           """Fetch returning body + headers + final URL. Falls back to curl."""
   74:     req = urllib.request.Request(url, headers={
   37:         "User-Agent": UA, "Accept": "text/html,application/xhtml+xml,*/*;q=0.8",
   37:         "Accept-Encoding": "gzip, deflate", "Accept-Language": "en-US,en;q=0.9",
           })
   37:     try:
   37:         ctx = ssl.create_default_context()
   37:         try:
   37:             import certifi
   37:             ctx = ssl.create_default_context(cafile=certifi.where())
               except Exception:
                   pass
   53:         with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
   16:             raw = r.read()
   16:             enc = (r.headers.get("Content-Encoding") or "").lower()
   16:             if "gzip" in enc:
   16:                 raw = gzip.decompress(raw)
                   elif "deflate" in enc:
                       try:
                           raw = zlib.decompress(raw)
                       except zlib.error:
                           raw = zlib.decompress(raw, -zlib.MAX_WBITS)
   32:             return {"url": r.url, "status": r.status, "body": raw.decode("utf-8", "replace"),
   16:                     "headers": dict(r.headers.items())}
   21:     except urllib.error.HTTPError as e:
   21:         return {"url": url, "status": e.code, "body": "", "headers": dict(e.headers.items()) if e.headers else {}}
           except Exception:
               return _curl_full(url, timeout)
       
       
    2: def _curl_full(url, timeout):
           try:
               p = subprocess.run(
                   ["curl", "-sSL", "--compressed", "-D", "-", "--max-time", str(timeout),
                    "-A", UA, "-w", "\n__FINAL__%{url_effective}\n__STATUS__%{http_code}", url],
                   capture_output=True, text=True, timeout=timeout + 15)
               out = p.stdout
               final = re.search(r"\n__FINAL__(.*)", out)
               status = re.search(r"\n__STATUS__(\d+)", out)
               out = re.sub(r"\n__FINAL__.*", "", out, flags=re.S)
               # Last header block then body
               parts = re.split(r"\r?\n\r?\n", out, maxsplit=0)
               headers = {}
               body = out
               for i, blk in enumerate(parts):
                   if blk.startswith("HTTP/"):
                       headers = {}
                       for line in blk.splitlines()[1:]:
                           if ":" in line:
                               k, _, v = line.partition(":")
                               headers[k.strip()] = v.strip()
                       body = "\n\n".join(parts[i + 1:])
               return {"url": final.group(1).strip() if final else url,
                       "status": int(status.group(1)) if status else 0,
                       "body": body, "headers": headers}
           except Exception as e:
               return {"url": url, "status": 0, "body": "", "headers": {}, "error": str(e)[:200]}
       
       
       # A dotted i18n key like "templateCenter.integration.clearbit.description" looks
       # exactly like a hostname unless the suffix is checked against real TLDs, which
       # is how an integrations catalogue produced confident vendor detections.
    2: TLD_RE = (r"\.(?:com|net|org|io|ai|co|dev|app|eu|jp|me|tv|cloud|gg|sh|xyz|us|uk|de|fr|"
                 r"br|mx|ca|au|in|cn|so|to|id|fm|live|site|online|tech|link|page|run|work|biz|"
                 r"info|cc|ly|es|it|nl|se|no|fi|dk|pl|ru|kr|tw|hk|sg|za|ie|at|ch|be|pt|gr|cz|"
                 r"com\.br|co\.uk|co\.jp|com\.au|com\.mx|co\.za)(?:[/:?\s\"\'<>]|$)")
       
       
    2: def _evidence_strength(matches, contexts=()):
           """Decide whether a detection is load evidence or just a name in the text.
       
           A bare product name matches anywhere it is mentioned -- including a target's
           own integrations directory or a competitor list -- so monday.com's i18n
           strings produced confident "Clearbit" and "Jotform" detections for vendors
           that load nothing. Treat a host, an ID shape or a JS global as strong, and a
           bare alphabetic name as weak.
           """
    1:     for m in matches:
    1:         if re.search(r"[a-z0-9-]+\.[a-z]{2,}(/|$)", m, re.I):      # a host
    1:             return "strong"
               if re.search(r"[A-Z]{2}-[A-Z0-9]{4,}|\d{6,}|_[a-z]+_|^phc_|^pk_live_", m):  # an ID
                   return "strong"
               if re.search(r"(fbq|ttq|twq|pintrk|rdt|qp|_linkedin|munchkin|piAId|obApi|Settings|load\()", m):
                   return "strong"
               # An asset path or injected global is served by the thing itself, so it
               # is load evidence even though it contains no host and no ID.
               if re.search(r"(^/|/_)(_?next|_?nuxt|astro|wp-content|wp-includes|gatsby)", m, re.I):
                   return "strong"
               if re.search(r"(__NEXT_DATA__|__NUXT__|___gatsby|astro-island|_vwo_|_learnq|"
                            r"intercomSettings|elqCfg|Shopify\.theme|data-domain-script|hjid|"
                            r"_vis_opt|phc_|pk_live_)", m):
                   return "strong"
       
           # A pattern can match only the bare vendor name inside what is actually a
           # hostname -- "contentsquare" out of "app.contentsquare.com", which came from
           # a CSP allowlist and is unambiguous load evidence. So check whether the match
           # sits inside a host or URL before calling it a mere mention. An i18n string
           # in an integrations catalogue has no TLD next to it and stays weak.
           for m in matches:
               token = re.escape(m.strip().strip("./"))
               if not token or len(token) < 3:
                   continue
               for ctx in contexts:
                   if re.search(r"[a-z0-9-]*" + token + r"[a-z0-9-]*" + TLD_RE, ctx, re.I):
                       return "strong"
                   if re.search(r"//[^\s\"\'<>]*" + token, ctx, re.I):
                       return "strong"
           return "weak"
       
       
    2: def fingerprint(html, source="html"):
           """Run the fingerprint catalogue over a blob of text.
       
           Entries carry explicit regex flags because the ID patterns (GTM-, G-, AW-)
           must stay case-sensitive -- lowercased near-misses like a `g-disabled` CSS
           class or a `gtm-tracking` data attribute otherwise masquerade as real IDs.
           """
    2:     hits = OrderedDict()
  234:     for entry in FINGERPRINTS:
  232:         label, pat, implies = entry[0], entry[1], entry[2]
  232:         flags = entry[3] if len(entry) > 3 else re.I
  232:         ms = list(re.finditer(pat, html, flags))
  232:         if not ms:
  231:             continue
    1:         ids = []
   21:         for m in ms[:20]:
   20:             got = next((g for g in m.groups() if g), None) if m.groups() else m.group(0)
   20:             if got:
   20:                 ids.append(got)
   21:         matched = [m.group(0) for m in ms[:20]]
   21:         windows = [html[max(0, m.start() - 60):m.end() + 60] for m in ms[:20]]
    2:         hits[label] = {"implies": implies, "occurrences": len(ms),
    1:                        "ids": sorted(set(ids))[:10], "source": source,
    1:                        "evidence": _evidence_strength(matched + ids, windows)}
    2:     return hits
       
       
    2: def third_party_hosts(html, own_host):
    2:     hosts = {}
  272:     for m in re.finditer(r"""(?:src|href)\s*=\s*["']((?:https?:)?//[^"'>\s]+)""", html, re.I):
  270:         u = m.group(1)
  270:         if u.startswith("//"):
                   u = "https:" + u
  270:         h = urllib.parse.urlparse(u).netloc.lower()
  270:         base = own_host.replace("www.", "")
  270:         if h and base not in h:
   31:             hosts[h] = hosts.get(h, 0) + 1
   52:     return [{"host": h, "refs": n} for h, n in sorted(hosts.items(), key=lambda x: -x[1])]
       
       
    2: def advertiser_identity(html, host, containers):
           """Work out who this company is *as an advertiser*, so their public ad
           libraries can be opened.
       
           The ad libraries are the only public source that shows what a competitor is
           actually running right now — the creative, the headline, the call to action
           and the date it started. A tag container shows the plumbing; the ad library
           shows the campaign. They answer different questions and the second one is
           usually the one people came for.
       
           Scoping matters: a keyword search on a brand name returns other advertisers'
           ads that merely mention it. Google's centre scopes by domain, which is exact.
           Meta scopes properly only by numeric Page ID, which many sites publish in an
           `fb:pages` meta tag.
           """
    2:     base = host.lower().replace("www.", "")
           # Take the registrable label, not the first one: "news.ycombinator.com" is
           # ycombinator, not news. Two-part public suffixes get one extra hop back.
    6:     labels = [l for l in base.split(".") if l]
    2:     two_part = {"co", "com", "org", "net", "gov", "edu", "ac"}
    2:     if len(labels) >= 3 and labels[-2] in two_part:
               brand = labels[-3]
    2:     elif len(labels) >= 2:
    2:         brand = labels[-2]
           else:
               brand = labels[0] if labels else base
       
    2:     ident = {"domain": base, "brand": brand, "facebook_page_ids": [], "facebook_slugs": []}
       
           # fb:pages is the exact numeric Page ID, when a site publishes it.
    3:     for m in re.finditer(r'<meta[^>]+property=["\']fb:pages["\'][^>]+content=["\']([^"\']+)', html, re.I):
    2:         ident["facebook_page_ids"] += [x.strip() for x in m.group(1).split(",") if x.strip().isdigit()]
       
           # Otherwise the social link gives a slug, which a human can resolve in one click.
    6:     for m in re.finditer(r'facebook\.com/([A-Za-z0-9._%-]{2,50})', html, re.I):
    4:         slug = m.group(1)
    4:         if slug.lower() not in ("sharer", "dialog", "plugins", "tr", "groups", "profile.php",
                                       "pages", "events", "watch", "login", "help"):
    4:             ident["facebook_slugs"].append(slug)
    2:     ident["facebook_slugs"] = sorted(set(ident["facebook_slugs"]))[:5]
    2:     ident["facebook_page_ids"] = sorted(set(ident["facebook_page_ids"]))[:5]
       
           # Ad account IDs already recovered from the containers.
    2:     aw, meta_pixels = set(), set()
    2:     for c in containers.values():
               if not isinstance(c, dict):
                   continue
